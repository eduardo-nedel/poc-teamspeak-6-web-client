# Porta do Servidor Gateway Node.js
PORT=4000

# Endereço do Servidor TeamSpeak 6
# Para conexão local via SSH tunnel: TS6_HOST=127.0.0.1
# Para conexão direta: TS6_HOST=seu_servidor_ts6.com
TS6_HOST=127.0.0.1
TS6_VOICE_HOST=seu_servidor_ts6.com  # ou IP do seu servidor TS6
TS6_VOICE_PORT=9987
TS6_SERVER_ID=1

# WebQuery API Key (gerada no TeamSpeak 6 ou no TS6 Manager)
# IMPORTANTE: Substitua pela sua chave real obtida no TS6 Manager
TS6_API_KEY=sua_chave_api_aqui

# Origem permitida para CORS
CORS_ORIGIN=*
